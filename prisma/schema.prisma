// Prisma is used ONLY as a schema-authoring and migration tool for this project.
// It runs against DIRECT_URL/DATABASE_URL at dev-time (`prisma migrate dev` / `migrate deploy`).
// The application itself never imports @prisma/client or talks to Postgres directly —
// all runtime reads/writes go through @supabase/supabase-js with the anon key, and access
// control is enforced entirely by the Row Level Security policies defined in
// prisma/migrations/*/migration.sql (see 0002_rls_and_defaults).
//
// auth.users is Supabase-managed (lives in the `auth` schema) and is intentionally NOT
// modeled here. Columns that reference it (Profile.userId, FamilyMember.userId) are plain
// uuid columns; the actual foreign key to auth.users is added as raw SQL in the migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CategoryType {
  expense
  income
  savings

  @@map("category_type")
}

enum InsuranceType {
  health
  life
  vehicle
  home
  other

  @@map("insurance_type")
}

enum AccountType {
  cash
  bank
  savings
  credit_card
  upi
  wallet
  other

  @@map("account_type")
}

enum TransactionType {
  expense
  income
  transfer
  savings

  @@map("transaction_type")
}

enum RecurringFrequency {
  daily
  weekly
  monthly
  yearly

  @@map("recurring_frequency")
}

model Profile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Family {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  currency  String   @default("INR")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members               FamilyMember[]
  categories            Category[]
  accounts              Account[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  quickAddPresets       QuickAddPreset[]
  telegramLinkCodes     TelegramLinkCode[]
  insurances            Insurance[]
  insuranceDocuments    InsuranceDocument[]

  @@map("families")
}

model FamilyMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  name           String
  avatarUrl      String?  @map("avatar_url")
  isActive       Boolean  @default(true) @map("is_active")
  telegramChatId BigInt?  @unique @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family            Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  recurring         RecurringTransaction[]
  presets           QuickAddPreset[]
  telegramLinkCodes TelegramLinkCode[]

  @@index([familyId])
  @@map("family_members")
}

model Category {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId  String       @map("family_id") @db.Uuid
  name      String
  type      CategoryType
  icon      String?
  color     String?
  parentId  String?      @map("parent_id") @db.Uuid
  isDefault Boolean      @default(false) @map("is_default")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family                Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent                Category?              @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories         Category[]             @relation("CategoryToSubcategory")
  transactions          Transaction[]
  budgets               Budget[]
  presets               QuickAddPreset[]
  recurringTransactions RecurringTransaction[]

  @@index([familyId])
  @@index([parentId])
  @@map("categories")
}

model Account {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId       String      @map("family_id") @db.Uuid
  name           String
  type           AccountType
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(14, 2)
  currentBalance Decimal     @default(0) @map("current_balance") @db.Decimal(14, 2)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family                 Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions           Transaction[]          @relation("AccountTransactions")
  transferInTransactions Transaction[]          @relation("TransferToAccount")
  recurring              RecurringTransaction[] @relation("RecurringAccount")
  recurringTransferTo    RecurringTransaction[] @relation("RecurringTransferToAccount")
  presets                QuickAddPreset[]

  @@index([familyId])
  @@map("accounts")
}

model Transaction {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId               String          @map("family_id") @db.Uuid
  memberId               String?         @map("member_id") @db.Uuid
  categoryId             String?         @map("category_id") @db.Uuid
  accountId              String?         @map("account_id") @db.Uuid
  transferToAccountId    String?         @map("transfer_to_account_id") @db.Uuid
  goalId                 String?         @map("goal_id") @db.Uuid
  type                   TransactionType
  amount                 Decimal         @db.Decimal(14, 2)
  transactionDate        DateTime        @map("transaction_date") @db.Date
  description            String?
  notes                  String?
  merchant               String?
  paymentMethod          String?         @map("payment_method")
  isRecurring            Boolean         @default(false) @map("is_recurring")
  recurringTransactionId String?         @map("recurring_transaction_id") @db.Uuid
  isDeleted              Boolean         @default(false) @map("is_deleted")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family               Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member               FamilyMember?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account              Account?              @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)
  transferToAccount    Account?              @relation("TransferToAccount", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  goal                 SavingsGoal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([transactionDate])
  @@index([categoryId])
  @@index([memberId])
  @@index([goalId])
  @@index([accountId])
  @@index([type])
  @@index([familyId, transactionDate])
  @@index([familyId, type, transactionDate])
  @@map("transactions")
}

model RecurringTransaction {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId            String             @map("family_id") @db.Uuid
  memberId            String?            @map("member_id") @db.Uuid
  categoryId          String?            @map("category_id") @db.Uuid
  accountId           String?            @map("account_id") @db.Uuid
  transferToAccountId String?            @map("transfer_to_account_id") @db.Uuid
  goalId              String?            @map("goal_id") @db.Uuid
  type                TransactionType
  amount              Decimal            @db.Decimal(14, 2)
  description         String?
  frequency           RecurringFrequency
  interval            Int                @default(1)
  startDate           DateTime           @map("start_date") @db.Date
  endDate             DateTime?          @map("end_date") @db.Date
  dayOfMonth          Int?               @map("day_of_month")
  nextRunDate         DateTime           @map("next_run_date") @db.Date
  lastGeneratedDate   DateTime?          @map("last_generated_date") @db.Date
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family                Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member                FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  category              Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account               Account?      @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: SetNull)
  transferToAccount     Account?      @relation("RecurringTransferToAccount", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  goal                  SavingsGoal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  generatedTransactions Transaction[]

  @@index([familyId])
  @@index([nextRunDate])
  @@index([goalId])
  @@map("recurring_transactions")
}

model Budget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId   String   @map("family_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  month      DateTime @db.Date
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([familyId, categoryId, month])
  @@index([familyId, month])
  @@map("budgets")
}

model SavingsGoal {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  name          String
  icon          String?
  targetAmount  Decimal   @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(14, 2)
  targetDate    DateTime? @map("target_date") @db.Date
  isCompleted   Boolean   @default(false) @map("is_completed")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family                Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([familyId])
  @@map("savings_goals")
}

/// Configurable one-tap quick-add buttons (e.g. "Morning Coffee" -> Food, ₹80, UPI).
model QuickAddPreset {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId   String          @map("family_id") @db.Uuid
  label      String
  icon       String?
  type       TransactionType
  amount     Decimal?        @db.Decimal(14, 2)
  categoryId String?         @map("category_id") @db.Uuid
  accountId  String?         @map("account_id") @db.Uuid
  memberId   String?         @map("member_id") @db.Uuid
  sortOrder  Int             @default(0) @map("sort_order")
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family   Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  member   FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@map("quick_add_presets")
}

/// Short-lived one-time codes for linking a family member's Telegram account
/// (Settings shows a code; the member sends `/link <code>` to the bot once).
model TelegramLinkCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  memberId  String    @map("member_id") @db.Uuid
  code      String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("telegram_link_codes")
}

/// A family's insurance policies (health, life, vehicle, ...), each with its own
/// uploaded documents (policy PDF, renewal notice, etc.) stored in Supabase Storage.
model Insurance {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId      String        @map("family_id") @db.Uuid
  name          String
  type          InsuranceType @default(other)
  provider      String?
  policyNumber  String?       @map("policy_number")
  premiumAmount Decimal?      @map("premium_amount") @db.Decimal(14, 2)
  renewalDate   DateTime?     @map("renewal_date") @db.Date
  notes         String?
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family    Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  documents InsuranceDocument[]

  @@index([familyId])
  @@map("insurances")
}

/// One uploaded file for an Insurance policy. storagePath points into the private
/// "insurance-documents" Supabase Storage bucket, namespaced "{family_id}/{insurance_id}/...".
model InsuranceDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  insuranceId String   @map("insurance_id") @db.Uuid
  familyId    String   @map("family_id") @db.Uuid
  fileName    String   @map("file_name")
  storagePath String   @map("storage_path")
  fileSize    Int?     @map("file_size")
  contentType String?  @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  insurance Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([insuranceId])
  @@map("insurance_documents")
}
