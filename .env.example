# Frontend runtime config (safe to expose — the anon key only ever grants what
# Row Level Security allows). Get both from Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Username (no @) of the Telegram bot members link to for chat-based transaction entry.
# Create one via @BotFather, then set this so Settings can show a "Message @bot" link.
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# Dev-time only — used exclusively by Prisma CLI (`prisma migrate dev` / `migrate deploy`)
# to apply schema migrations. NEVER imported by the app, never shipped to the browser.
# Get the password from Supabase dashboard > Project Settings > Database.
# Transaction-mode pooler (pgbouncer) — fine for one-off `migrate deploy` runs:
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — required by `prisma migrate dev` (needs advisory locks pgbouncer can't do):
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"
